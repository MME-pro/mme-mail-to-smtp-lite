msgstr "Kopieren"

#: src/components/provider-form.js:215
msgid "Copy to clipboard"
msgstr "In die Zwischenablage kopieren"

#: src/components/provider-form.js:273
msgid "Stored. Leave blank to keep it."
msgstr "Gespeichert. Leer lassen, um ihn beizubehalten."

#: src/components/provider-form.js:306
msgid "Enabled"
msgstr "Aktiviert"

#: src/components/provider-picker.js:67
msgid "Pro"
msgstr "Pro"

#: src/components/redirect-uri.js:34
msgid "Redirect URI"
msgstr "Weiterleitungs-URI"

#: src/lib/pro.js:19
msgid "Microsoft 365"
msgstr "Microsoft 365"

#: src/lib/pro.js:20
msgid "Microsoft 365, Outlook.com and Exchange Online."
msgstr "Microsoft 365, Outlook.com und Exchange Online."

#: src/lib/pro.js:26
msgid "Google one-click"
msgstr "Google mit einem Klick"

#: src/lib/pro.js:27
msgid "Sign in with Google, with no Cloud project of your own to set up."
msgstr "Mit Google anmelden, ohne ein eigenes Cloud-Projekt einrichten zu müssen."

#: src/lib/pro.js:31
msgid "Zoho Mail"
msgstr "Zoho Mail"

#: src/lib/pro.js:32
msgid "Zoho Mail and Zoho Workplace."
msgstr "Zoho Mail und Zoho Workplace."

#: src/screens/connections.js:30
msgid "Every message WordPress sends goes out over this connection."
msgstr "Jede Nachricht, die WordPress versendet, geht über diese Verbindung hinaus."

#: src/screens/connections.js:113
msgid "Connection saved."
msgstr "Verbindung gespeichert."

#: src/screens/connections.js:152
msgid "Fill in %s before verifying."
msgstr "Füllen Sie %s aus, bevor Sie prüfen."

#: src/screens/connections.js:186
msgid "Connection"
msgstr "Verbindung"

#: src/screens/connections.js:258
msgid "Save connection"
msgstr "Verbindung speichern"

#: src/screens/connections.js:262 src/screens/setup.js:73
msgid "Verify"
msgstr "Prüfen"

#: src/screens/connections.js:277
msgid "This clears the provider, every credential and the From address on this connection. Mail routed here stops. Continue?"
msgstr "Damit werden Anbieter, sämtliche Zugangsdaten und die Absenderadresse dieser Verbindung gelöscht. Hierher geleitete E-Mails werden nicht mehr versendet. Fortfahren?"

#: src/screens/connections.js:329
msgid "Checked at %s"
msgstr "Geprüft um %s"

#: src/screens/connections.js:354
msgid "Send a test message"
msgstr "Testnachricht senden"

#: src/screens/connections.js:359
msgid "Goes out over the %s connection only."
msgstr "Wird nur über die Verbindung „%s“ gesendet."

#: src/screens/connections.js:362
msgid "Goes out over the primary connection."
msgstr "Geht über die primäre Verbindung hinaus."

#: src/screens/connections.js:368
msgid "Recipient"
msgstr "Empfänger"

#: src/screens/connections.js:382 src/screens/setup.js:736
msgid "Send test"
msgstr "Test senden"

#: src/screens/connections.js:399
msgid "Set up the primary connection first. The backup is only used when the primary fails, so on its own it sends nothing."
msgstr "Richten Sie zuerst die primäre Verbindung ein. Die Backup-Verbindung wird nur genutzt, wenn die primäre ausfällt – allein sendet sie nichts."

#: src/screens/connections.js:404
msgid "This uses the same service as the primary, so an outage there stops both. Choose a different one."
msgstr "Diese Verbindung nutzt denselben Dienst wie die primäre, sodass ein Ausfall dort beide stoppt. Wählen Sie einen anderen."

#: src/screens/dashboard.js:69
msgid "Not sending yet"
msgstr "Versendet noch nicht"

#: src/screens/dashboard.js:73
msgid "Sending is failing"
msgstr "Der Versand schlägt fehl"

#: src/screens/dashboard.js:77
msgid "Sending is working"
msgstr "Der Versand funktioniert"

#: src/screens/dashboard.js:85
msgid "No provider is configured, so WordPress is still using the server mail function."
msgstr "Es ist kein Anbieter konfiguriert, WordPress verwendet daher weiterhin die Mail-Funktion des Servers."

#: src/screens/dashboard.js:92
msgid "%d sends have failed in a row. wp_mail() is returning false, so the code that sent them knows."
msgstr "%d Sendevorgänge sind nacheinander fehlgeschlagen. wp_mail() gibt false zurück, der sendende Code weiß also Bescheid."

#: src/screens/dashboard.js:101
msgid "Last message delivered %s."
msgstr "Letzte Nachricht zugestellt %s."

#: src/screens/dashboard.js:105
msgid "A provider is configured. Nothing has been sent through it yet."
msgstr "Ein Anbieter ist konfiguriert. Darüber wurde noch nichts versendet."

#: src/screens/dashboard.js:122
msgid "Delivery"
msgstr "Zustellung"

#: src/screens/dashboard.js:156
msgid "Retried every five minutes."
msgstr "Wird alle fünf Minuten erneut versucht."

#: src/screens/dashboard.js:159
msgid "Never delivered"
msgstr "Nie zugestellt"

#: src/screens/dashboard.js:163
msgid "Out of attempts. Kept until the discard window passes."
msgstr "Keine Versuche mehr. Wird aufbewahrt, bis die Verwerfungsfrist abläuft."

#: src/screens/dashboard.js:192
msgid "Nothing is sending yet"
msgstr "Es wird noch nichts versendet"

#: src/screens/dashboard.js:195
msgid "WordPress is still using the server mail function. The wizard connects a mailbox, checks the credentials against the provider and sends one real message, in that order."
msgstr "WordPress verwendet weiterhin die Mail-Funktion des Servers. Der Assistent verbindet ein Postfach, prüft die Zugangsdaten beim Anbieter und sendet eine echte Nachricht – in dieser Reihenfolge."

#: src/screens/dashboard.js:235
msgid "Where to look next"
msgstr "Wo Sie als Nächstes nachsehen"

#: src/screens/dashboard.js:236
msgid "This plugin keeps no copy of what it sent. A failure is reported the moment it happens, through wp_mail() and the checks below."
msgstr "Dieses Plugin bewahrt keine Kopie des Versendeten auf. Ein Fehler wird in dem Moment gemeldet, in dem er auftritt – über wp_mail() und die Prüfungen unten."

#: src/screens/dashboard.js:250
msgid "send a test message and confirm the credentials still work."
msgstr "senden Sie eine Testnachricht und bestätigen Sie, dass die Zugangsdaten weiterhin funktionieren."

#: src/screens/dashboard.js:258
msgid "Tools, Site Health"
msgstr "Werkzeuge, Website-Zustand"

#: src/screens/dashboard.js:261
msgid "the Email delivery check reports whether sending is working, and names the last error."
msgstr "die Prüfung „E-Mail-Zustellung“ meldet, ob der Versand funktioniert, und nennt den letzten Fehler."

#: src/screens/dashboard.js:275
msgid "how many failures in a row count as an outage, and how long the retry queue holds a message."
msgstr "wie viele Fehler nacheinander als Ausfall gelten und wie lange die Wiederholungswarteschlange eine Nachricht aufbewahrt."

#: src/screens/settings.js:31
msgid "Settings saved."
msgstr "Einstellungen gespeichert."

#: src/screens/settings.js:45
msgid "Reliability"
msgstr "Zuverlässigkeit"

#: src/screens/settings.js:51
msgid "Hold on to messages that failed for a temporary reason and retry them"
msgstr "Nachrichten aufbewahren, die aus einem vorübergehenden Grund fehlgeschlagen sind, und erneut versuchen"

#: src/screens/settings.js:63
msgid "Discard undelivered messages after (days)"
msgstr "Nicht zugestellte Nachrichten verwerfen nach (Tagen)"

#: src/screens/settings.js:82
msgid "Failure detection"
msgstr "Fehlererkennung"

#: src/screens/settings.js:83
msgid "Almost nothing in WordPress checks what wp_mail() returned, so this decides when the plugin says so itself."
msgstr "Fast nichts in WordPress prüft, was wp_mail() zurückgegeben hat – dies entscheidet daher, wann das Plugin es selbst sagt."

#: src/screens/settings.js:91
msgid "Report broken after N failures"
msgstr "Als gestört melden nach N Fehlern"

#: src/screens/settings.js:92
msgid "Consecutive failures, not failures in total. One success resets the count, so a single bad address never triggers it."
msgstr "Aufeinanderfolgende Fehler, nicht Fehler insgesamt. Ein Erfolg setzt die Zählung zurück – eine einzelne falsche Adresse löst es also nie aus."

#: src/screens/settings.js:115
msgid "When you actually get told"
msgstr "Wann Sie es tatsächlich erfahren"

#: src/screens/settings.js:118
msgid "A failed send is reported immediately, every time, and wp_mail() returns false so the code that sent it knows."
msgstr "Ein fehlgeschlagener Versand wird sofort gemeldet, jedes Mal, und wp_mail() gibt false zurück, damit der sendende Code Bescheid weiß."

#: src/screens/settings.js:124
msgid "Once that many sends fail in a row, the plugin reports sending as broken: an admin notice appears and the Email delivery check under Tools, Site Health turns red. One success clears it."
msgstr "Sobald so viele Sendevorgänge nacheinander fehlschlagen, meldet das Plugin den Versand als gestört: Ein Admin-Hinweis erscheint und die Prüfung „E-Mail-Zustellung“ unter Werkzeuge, Website-Zustand wird rot. Ein Erfolg hebt das wieder auf."

#: src/screens/settings.js:138
msgid "Privacy"
msgstr "Datenschutz"

#: src/screens/settings.js:141
msgid "This plugin keeps no record of what it sent. A queued message is kept in full until it is delivered or discarded, and nothing else. No cookies, no tracking pixels, no IP addresses."
msgstr "Dieses Plugin führt keine Aufzeichnung über das Versendete. Eine eingereihte Nachricht wird vollständig aufbewahrt, bis sie zugestellt oder verworfen ist – mehr nicht. Keine Cookies, keine Tracking-Pixel, keine IP-Adressen."

#: src/screens/settings.js:152
msgid "This plugin sends nothing to its own vendor. No registration, no check-in, no usage figures - the only servers it contacts are the mail providers you configure."
msgstr "Dieses Plugin sendet nichts an seinen eigenen Hersteller. Keine Registrierung, keine Rückmeldung, keine Nutzungszahlen – die einzigen Server, die es kontaktiert, sind die von Ihnen konfigurierten Mail-Anbieter."

#: src/screens/settings.js:163
msgid "Export personal data"
msgstr "Personenbezogene Daten exportieren"

#: src/screens/settings.js:169
msgid "Erase personal data"
msgstr "Personenbezogene Daten löschen"

#: src/screens/settings.js:175
msgid "Privacy policy text"
msgstr "Text der Datenschutzerklärung"

#: src/screens/settings.js:186
msgid "Setup wizard"
msgstr "Einrichtungsassistent"

#: src/screens/settings.js:187
msgid "Walks through choosing a provider, connecting a mailbox, verifying the credentials and sending a test. It edits the primary connection, so nothing already configured is lost by opening it."
msgstr "Führt durch die Wahl eines Anbieters, das Verbinden eines Postfachs, das Prüfen der Zugangsdaten und einen Testversand. Er bearbeitet die primäre Verbindung – durch das Öffnen geht also nichts bereits Konfiguriertes verloren."

#: src/screens/settings.js:195
msgid "Open the setup wizard"
msgstr "Einrichtungsassistenten öffnen"

#: src/screens/settings.js:206
msgid "Save settings"
msgstr "Einstellungen speichern"

#: src/screens/setup.js:71 src/screens/setup.js:813
msgid "Provider"
msgstr "Anbieter"

#: src/screens/setup.js:74
msgid "Test"
msgstr "Test"

#: src/screens/setup.js:75
msgid "Finish"
msgstr "Abschließen"

#: src/screens/setup.js:189
msgid "Back"
msgstr "Zurück"

#: src/screens/setup.js:209
msgid "Let us get this site sending properly."
msgstr "Bringen wir diese Website dazu, richtig zu versenden."

#: src/screens/setup.js:210
msgid "WordPress is currently handing email to the server’s own mail function, which most inboxes now treat as unsigned post. Four short steps connect a real mailbox instead, and nothing is written until you press Save."
msgstr "WordPress übergibt E-Mails derzeit an die eigene Mail-Funktion des Servers, die die meisten Postfächer inzwischen wie unsignierte Post behandeln. Vier kurze Schritte verbinden stattdessen ein echtes Postfach, und es wird nichts geschrieben, bis Sie auf Speichern klicken."

#: src/screens/setup.js:220
msgid "Begin setup"
msgstr "Einrichtung beginnen"

#: src/screens/setup.js:230
msgid "Pick a provider"
msgstr "Anbieter wählen"

#: src/screens/setup.js:231
msgid "Google signs in with a single click. Everything else takes an API key."
msgstr "Google meldet sich mit einem einzigen Klick an. Alles andere benötigt einen API-Schlüssel."

#: src/screens/setup.js:238
msgid "Prove it works"
msgstr "Nachweisen, dass es funktioniert"

#: src/screens/setup.js:239
msgid "The credentials are checked against the provider before you leave this screen."
msgstr "Die Zugangsdaten werden beim Anbieter geprüft, bevor Sie diese Ansicht verlassen."

#: src/screens/setup.js:246
msgid "Send one message"
msgstr "Eine Nachricht senden"

#: src/screens/setup.js:247
msgid "A real email, sent with the safety nets off, so a failure cannot hide behind a retry."
msgstr "Eine echte E-Mail, ohne Sicherheitsnetze versendet, damit sich ein Fehler nicht hinter einem Wiederholungsversuch verstecken kann."

#: src/screens/setup.js:379
msgid "Setup finished."
msgstr "Einrichtung abgeschlossen."

#: src/screens/setup.js:413
msgid "Fill in %s first."
msgstr "Füllen Sie zuerst %s aus."

#: src/screens/setup.js:440
msgid "Finish this later"
msgstr "Später abschließen"

#: src/screens/setup.js:451 src/screens/setup.js:529 src/screens/setup.js:612 src/screens/setup.js:712
msgid "Step %1$d of %2$d"
msgstr "Schritt %1$d von %2$d"

#: src/screens/setup.js:455
msgid "How should this site send its email?"
msgstr "Wie soll diese Website ihre E-Mails versenden?"

#: src/screens/setup.js:456
msgid "Google needs an OAuth client or a service account key from the Google Cloud console. The rest need an API key from the service, which takes a minute to create."
msgstr "Google benötigt einen OAuth-Client oder einen Dienstkonto-Schlüssel aus der Google-Cloud-Konsole. Alle anderen benötigen einen API-Schlüssel des Dienstes, dessen Erstellung eine Minute dauert."

#: src/screens/setup.js:468 src/screens/setup.js:631 src/screens/setup.js:739
msgid "Continue"
msgstr "Weiter"

#: src/screens/setup.js:490
msgid "Choose one to continue. It can be changed later without losing anything."
msgstr "Wählen Sie einen aus, um fortzufahren. Er lässt sich später ändern, ohne dass etwas verloren geht."

#: src/screens/setup.js:510
msgid "No provider chosen yet"
msgstr "Noch kein Anbieter gewählt"

#: src/screens/setup.js:511
msgid "This step asks for the credentials the provider needs, and which credentials those are depends on the provider. Go back and pick one."
msgstr "Dieser Schritt fragt nach den Zugangsdaten, die der Anbieter benötigt – und welche das sind, hängt vom Anbieter ab. Gehen Sie zurück und wählen Sie einen aus."

#: src/screens/setup.js:517
msgid "Choose a provider"
msgstr "Einen Anbieter wählen"

#: src/screens/setup.js:535
msgid "Connect %s"
msgstr "%s verbinden"

#: src/screens/setup.js:536
msgid "the provider"
msgstr "den Anbieter"

#: src/screens/setup.js:547
msgid "Save and continue"
msgstr "Speichern und fortfahren"

#: src/screens/setup.js:616
msgid "Check the credentials reach the mailbox"
msgstr "Prüfen, ob die Zugangsdaten das Postfach erreichen"

#: src/screens/setup.js:617
msgid "This asks the provider whether it recognises what was saved, and whether the mailbox is one this connection is allowed to send from. Nothing is emailed yet."
msgstr "Dies fragt den Anbieter, ob er das Gespeicherte erkennt und ob das Postfach eines ist, von dem diese Verbindung senden darf. Es wird noch nichts per E-Mail versendet."

#: src/screens/setup.js:626
msgid "Continue anyway"
msgstr "Trotzdem fortfahren"

#: src/screens/setup.js:643
msgid "Check again"
msgstr "Erneut prüfen"

#: src/screens/setup.js:644
msgid "Verify connection"
msgstr "Verbindung prüfen"

#: src/screens/setup.js:676
msgid "Asking the provider…"
msgstr "Anbieter wird gefragt…"

#: src/screens/setup.js:678
msgid "The provider accepted it."
msgstr "Der Anbieter hat es angenommen."

#: src/screens/setup.js:680
msgid "The provider refused."
msgstr "Der Anbieter hat abgelehnt."

#: src/screens/setup.js:681
msgid "Not checked yet."
msgstr "Noch nicht geprüft."

#: src/screens/setup.js:685
msgid "Press Verify. Any unsaved edit on the previous step is saved first, because the check runs against what is stored."
msgstr "Klicken Sie auf Prüfen. Nicht gespeicherte Änderungen aus dem vorherigen Schritt werden zuerst gespeichert, denn die Prüfung läuft gegen das, was gespeichert ist."

#: src/screens/setup.js:697
msgid "The message above comes from the provider, not from this plugin - it names what is actually wrong. Go back a step to correct it."
msgstr "Die Meldung oben stammt vom Anbieter, nicht von diesem Plugin – sie benennt, was tatsächlich falsch ist. Gehen Sie einen Schritt zurück, um es zu korrigieren."

#: src/screens/setup.js:716
msgid "Send one real message"
msgstr "Eine echte Nachricht senden"

#: src/screens/setup.js:717
msgid "It goes out over this connection with the retry queue switched off, so a failure here is the connection failing rather than something else quietly covering for it."
msgstr "Sie geht über diese Verbindung hinaus, mit abgeschalteter Wiederholungswarteschlange – ein Fehler hier ist also ein Fehler der Verbindung und nicht etwas anderes, das ihn still überdeckt."

#: src/screens/setup.js:735
msgid "Send another"
msgstr "Weitere senden"

#: src/screens/setup.js:747
msgid "Send to"
msgstr "Senden an"

#: src/screens/setup.js:749
msgid "Your own address is the fastest way to find out. Somewhere outside this domain tells you more."
msgstr "Ihre eigene Adresse ist der schnellste Weg, es herauszufinden. Eine Adresse außerhalb dieser Domain sagt mehr aus."

#: src/screens/setup.js:780
msgid "Setup complete"
msgstr "Einrichtung abgeschlossen"

#: src/screens/setup.js:783
msgid "WordPress is sending through your provider."
msgstr "WordPress versendet über Ihren Anbieter."

#: src/screens/setup.js:784
msgid "Nothing is configured yet."
msgstr "Es ist noch nichts konfiguriert."

#: src/screens/setup.js:788
msgid "Every message this site sends now goes out over this connection, and every attempt is recorded with whatever the provider said about it."
msgstr "Jede Nachricht, die diese Website versendet, geht jetzt über diese Verbindung hinaus, und jeder Versuch wird mit dem festgehalten, was der Anbieter dazu gesagt hat."

#: src/screens/setup.js:792
msgid "You can leave now and come back to this at any time - the wizard is always available from the dashboard."
msgstr "Sie können jetzt gehen und jederzeit hierher zurückkehren – der Assistent ist immer über das Dashboard erreichbar."

#: src/screens/setup.js:806
msgid "Go to the dashboard"
msgstr "Zum Dashboard"

#: src/screens/setup.js:817
msgid "Sends as"
msgstr "Versendet als"

#: src/screens/setup.js:820
msgid "Not set"
msgstr "Nicht gesetzt"

#: src/screens/setup.js:823
msgid "Test message"
msgstr "Testnachricht"

#: src/screens/setup.js:826
msgid "Accepted"
msgstr "Angenommen"

#: src/screens/setup.js:827
msgid "Refused"
msgstr "Abgelehnt"

#: src/screens/setup.js:828
msgid "Not sent"
msgstr "Nicht versendet"

#: src/screens/setup.js:881
msgid "Credentials are stored on this site and sent only to the provider they belong to."
msgstr "Zugangsdaten werden auf dieser Website gespeichert und nur an den Anbieter gesendet, zu dem sie gehören."
